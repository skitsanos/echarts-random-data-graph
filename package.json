{
  "name": "signal-telemetry-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "tsc --noEmit && bun build ./index.html --outdir=dist --minify --target=browser",
    "preview": "bun ./dist/index.html",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "echarts": "6.1.0" },
  "devDependencies": { "@types/bun": "latest", "typescript": "7.0.2" }
}
